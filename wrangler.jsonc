{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rental-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",

  // 前端构建产物由 Worker 一并托管，无需单独部署
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    // vue-router 使用 createWebHistory，未知路径需回落到 index.html
    "not_found_handling": "single-page-application",
    // API 与上传文件必须先进 Worker，其余走静态资源
    "run_worker_first": ["/api/*", "/uploads/*"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rental-db",
      "database_id": "108af864-1056-4b03-8207-e2c5ab5e87a2",
      "migrations_dir": "migrations"
    }
  ],

  // 线上自定义域名（DNS 与证书由 Cloudflare 自动托管）
  "routes": [
    {
      "pattern": "nxzj.wsad.eu.org",
      "custom_domain": true
    }
  ],

  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "rental-uploads"
    }
  ],

  // 关闭 Workers Logs（观测/日志推送），如需排查问题再改回 true 并重新部署
  "observability": {
    "enabled": false
  }
}
